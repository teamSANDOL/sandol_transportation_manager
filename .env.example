# Compose 가 host 에 노출하는 API 포트다.
API_PORT=8000
# 서비스 이미지 태그다.
TAG=latest

# PostgreSQL 데이터베이스 이름이다.
POSTGRES_DB=transportation_manager
# PostgreSQL 사용자다.
POSTGRES_USER=transportation
# PostgreSQL 비밀번호다. 실제 값으로 바꾼다. 비우면 시작하지 않는다.
POSTGRES_PASSWORD=change-this-db-password

# 1 이면 개발용 키오스크 화면(/demo 와 /static)을 제공하고, 0 이면 아예 등록하지 않아 404 가 된다.
# API 와 health 는 모드와 무관하게 열려 있다. 운영에서는 0 으로 둔다.
DEV_FRONTEND_MODE=0

# 도착정보를 사용자가 요청할 때만 가져올지 정한다. 1 이면 true, 0 이면 false 다.
# 1 이면 아래 주기 설정과 무관하게 자동 조회를 하지 않는다. 데모와 개발에서 API key 의 일일 한도(quota)를 소모하지 않으려고 쓴다.
BUS_FETCH_ON_DEMAND_ONLY=1
# 피크 시간대다. HHMM-HHMM 을 쉼표로 이어 여러 개 쓴다. 0700-1000,1600-2000 은 07~10시와 16~20시다.
# 끝이 시작보다 작으면 자정을 넘기는 구간으로 읽는다. 피크가 아닌 운행 시간은 비피크로 본다.
BUS_POLL_PEAK_WINDOWS=0700-1000,1600-2000
# 피크 시간대에 몇 초에 한 번 가져올지 정한다. 정수이며 0 이면 자동으로 가져오지 않는다.
BUS_POLL_PEAK_SECONDS=30
# 비피크 시간대에 몇 초에 한 번 가져올지 정한다. 정수이며 0 이면 자동으로 가져오지 않는다.
BUS_POLL_OFFPEAK_SECONDS=0
# 가져오지 않는 시간대다. 형식은 BUS_POLL_PEAK_WINDOWS 와 같다. 1930-0450 은 19시 30분부터 다음 날 04시 50분까지다.
# 비우면 시간대 제한 없이 가져온다.
BUS_POLL_PAUSE_WINDOWS=0230-0500

# 클라이언트 IP 당 분당 요청 수 한도다. 인증이 없는 API 가 GBIS quota 를 소모하지 못하게 막는다.
BUS_RATE_LIMIT_PER_MINUTE=30
# 키의 남은 quota 가 이 값 이하이면 다음 키로 넘어간다.
BUS_QUOTA_THRESHOLD=10
# 요청 시 조회 cache 를 신선하다고 보는 시간(초)이다. 이 시간 안의 재요청은 GBIS 를 부르지 않는다.
BUS_ON_DEMAND_TTL_SECONDS=40

# data.go.kr 경기도 버스도착정보 API 인증키다. 1번부터 차례로 쓰고 비었거나 없는 번호는 건너뛴다.
# 한 키의 일일 한도(10,000)가 거의 찼을 때 다음 키로 넘어가려고 4개까지 둔다. 실제 값은 .env 에만 적고 commit 하지 않는다.
DATA_GO_KR_KEY1=
DATA_GO_KR_KEY2=
DATA_GO_KR_KEY3=
DATA_GO_KR_KEY4=
